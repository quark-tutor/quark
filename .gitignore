# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# but keep the template
!.env.example

# family seed data (real nicknames and emails)
/scripts/family.local.json
# the test copy’s family: invented children, one plus-address guardian
/scripts/family.test.json

# model requests and replies from week:build --debug
/.quark-debug/

# Exported cards name the children (rule 7): kept on the laptop, never committed.
/plan/candidates/day1-*.json

# Claude Code worktrees and debug output (the debug files name the children)
/.claude/worktrees/

plan/candidates/*.json

# the board page, rewritten by npm run docs:board
/Quark board.html

# voice samples for picking the tutor's voice (npm run speech:samples); the report names the pick
/docs/reports/samples/

# the iPad dev server's certificate for the laptop's home address (npm run dev:ipad)
/certificates/
