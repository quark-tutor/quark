# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard → Project Settings → API keys (and Data API for the URL).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...), or the legacy anon key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...), or the legacy service_role key. Server only. Bypasses RLS.
SUPABASE_SECRET_KEY=

# Postgres connection string, for applying migrations only (not used by the app).
# Supabase dashboard → Connect → Session pooler. Includes the database password.
SUPABASE_DB_URL=

# Anthropic API key (sk-ant-...), for curation and the policy gate. Server only; never commit it.
# console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Model names, read by core/model.ts. Curation writes the shared ideas (facts: the strongest model);
# writing renders them as each child's cards (a cheaper model is fine); the gate checks every card.
QUARK_MODEL_CURATE=claude-opus-5-5
QUARK_MODEL_WRITE=claude-sonnet-5-5
QUARK_MODEL_GATE=claude-opus-5-5
