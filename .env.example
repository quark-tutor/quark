# Two files, two projects. Never commit either.
#   .env.local       the TEST project (quark-test). Every default script and `npm run dev` read it.
#   .env.live.local  the LIVE project (the boys’ copy). Only the :live scripts read it, and they ask first.
# Copy this file to both and fill each in. Nothing is ever copied from live to test.
#
# Which project this file is for. Scripts refuse to run if it disagrees with the file they loaded.
# Use test in .env.local and live in .env.live.local.
QUARK_TARGET=

# Supabase dashboard → Project Settings → API keys (and Data API for the URL).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...), or the legacy anon key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...), or the legacy service_role key. Server only. Bypasses RLS.
SUPABASE_SECRET_KEY=

# Postgres connection string, for applying migrations only (not used by the app).
# Supabase dashboard → Connect → Session pooler. Includes the database password.
SUPABASE_DB_URL=

# Anthropic API key (sk-ant-...), for curation and the policy gate. Server only; never commit it.
# console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# The tutor's voice and ears (core/speech.ts): a Google Cloud service account's key, with the Cloud Text-to-Speech
# and Cloud Speech-to-Text APIs enabled in its project. Server only; never commit the key or keep it in the repository.
# On the laptop, the path to the key's JSON file, kept outside the repository:
GOOGLE_APPLICATION_CREDENTIALS=
# On Vercel, which has no files, the key's JSON itself, on one line (GOOGLE_APPLICATION_CREDENTIALS may hold it instead):
GOOGLE_CREDENTIALS_JSON=

# The Sunday build (app/api/cron/week). Vercel sends this as "Authorization: Bearer <value>" on each cron
# firing, and the route answers 401 and does nothing to anything else, or when this is not set. At least 16
# random characters (a password generator will do). Use a different value in .env.local (test) and in
# Vercel's production environment; setting the Vercel one is what starts the Sunday build.
CRON_SECRET=

# Model names, read by core/model.ts. Curation writes the shared ideas (facts: the strongest model);
# writing renders them as each child's cards (a cheaper model is fine); the gate checks every card.
QUARK_MODEL_CURATE=claude-opus-5-5
QUARK_MODEL_WRITE=claude-sonnet-5-5
QUARK_MODEL_GATE=claude-opus-5-5
